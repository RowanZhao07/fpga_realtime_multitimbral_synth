// Tang Mega 60K NEO J13: schematic p19 physical pin -> SDRAM0_Dn;
// Sipeed TangMega-60K-example/sdram_neo/src/sdram.cst -> 60K FPGA ball.
// A: J13-1/2. B: J13-13/14 (SDRAM0_D13/D12). Both addresses 0x5A.
IO_LOC "mpr_scl" E14;
IO_LOC "mpr_sda" E13;
IO_LOC "mpr_b_scl" A16;
IO_LOC "mpr_b_sda" A15;
// ADS1115: J13-15/16 (SDRAM0_D11/D10), ADDR=GND -> 0x48.
IO_LOC "pressure_scl" A20;
IO_LOC "pressure_sda" B20;
// PCB U5 -> U6 SN74HC595 chain: 16 shift bits drive 13 key LEDs.
// J13-17/18/19/20 -> D9/D8/A12/CLK. All are 3.3V GPIO here.
IO_LOC "led_ser" A21;
IO_LOC "led_srclk" B21;
IO_LOC "led_rclk" B18;
IO_LOC "led_oe_n" B17;
// UART: J13-21=A9/C17 receives module TXD; J13-22=A11/D17 drives RXD.
IO_LOC "control_rx" C17;
IO_LOC "control_tx" D17;
IO_PORT "control_rx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_PORT "control_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP DRIVE=4;
IO_PORT "led_ser" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=DOWN DRIVE=4;
IO_PORT "led_srclk" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=DOWN DRIVE=4;
IO_PORT "led_rclk" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=DOWN DRIVE=4;
IO_PORT "led_oe_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP DRIVE=4;
IO_LOC "dac_bck" C15;
IO_LOC "dac_lrck" C14;
IO_LOC "dac_din" B13;
IO_PORT "mpr_scl" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "mpr_sda" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "mpr_b_scl" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "mpr_b_sda" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "pressure_scl" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "pressure_sda" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_lrck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_LOC "led[0]" P19;
IO_LOC "led[1]" R19;
IO_LOC "led[2]" T21;
IO_LOC "led[3]" U21;
IO_LOC "led[4]" P16;
IO_LOC "led[5]" R17;
IO_LOC "led[6]" R18;
IO_LOC "led[7]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Sipeed 60K on-board crystal; no external connection required.
IO_LOC "ref_clk" V22;
IO_PORT "ref_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
CLOCK_LOC "clk" BUFG = CLK;

// Sipeed TangMega-60K-example/cam_dvi/src/NEO_DOCK.cst, differential pairs.
IO_LOC "tmds_p[0]" J14,H14;
IO_LOC "tmds_p[1]" J15,H15;
IO_LOC "tmds_p[2]" K17,J17;
IO_LOC "tmds_clock_p" G15,G16;
IO_PORT "tmds_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_clock_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hpd_en" K13;
IO_PORT "hpd_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=12 BANK_VCCIO=3.3;
CLOCK_LOC "pixel_clk" BUFG = CLK;
CLOCK_LOC "serial_clk" BUFG = CLK;
INS_LOC "display_clock/pll" PLL_R[0];

// Keep each serializer's reset-release flops beside its local reset LUT.
// Unconstrained lane 0 placed a flop at R18C92 but its LUT at R5C125,
// violating FCLK falling-edge recovery. These are fabric placements only;
// all pixel/serial setup, hold, recovery and removal checks remain enabled.
INS_LOC "transmitter/lanes[0].reset_pipe_0_s1" R5C125;
INS_LOC "transmitter/lanes[0].reset_pipe_1_s1" R5C125;
INS_LOC "transmitter/lanes[0].reset_pipe_2_s1" R5C125;
INS_LOC "transmitter/lanes[0].reset_gate" R5C125;
INS_LOC "transmitter/lanes[1].reset_pipe_0_s1" R4C126;
INS_LOC "transmitter/lanes[1].reset_pipe_1_s1" R4C126;
INS_LOC "transmitter/lanes[1].reset_pipe_2_s1" R4C126;
INS_LOC "transmitter/lanes[1].reset_gate" R4C126;
// Lane 2 drives IOR39: move its release logic closer to that serializer.
INS_LOC "transmitter/lanes[2].reset_pipe_0_s1" R9C126;
INS_LOC "transmitter/lanes[2].reset_pipe_1_s1" R9C126;
INS_LOC "transmitter/lanes[2].reset_pipe_2_s1" R9C126;
INS_LOC "transmitter/lanes[2].reset_gate" R9C126;
INS_LOC "transmitter/lanes[3].reset_pipe_0_s1" R4C126;
INS_LOC "transmitter/lanes[3].reset_pipe_1_s1" R4C126;
INS_LOC "transmitter/lanes[3].reset_pipe_2_s1" R4C126;
INS_LOC "transmitter/lanes[3].reset_gate" R4C126;

// SDRAM0 D7/D6/D5, unused by the instrument; Sipeed sdram_neo reference.
IO_LOC "encoder_a" A13;
IO_LOC "encoder_b" A14;
IO_LOC "encoder_sw_n" C13;
IO_PORT "encoder_a" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_PORT "encoder_b" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_PORT "encoder_sw_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;

// Shared ADS1115 keeps pressure_scl/sda on J13-15/16; VRx goes to AIN1.
// KY-023 switch: J13-23/A7/A19. External pull-up to 3.3V recommended.
IO_LOC "joystick_sw_n" A19;
IO_PORT "joystick_sw_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;

// J13-9 = SDRAM0_D15 = B16 (3.3V bank), separate from J13-11's 5V rail.
// Joystick profile drives high; legacy profiles release it. One joystick only:
// measured isolated VCC-GND ~2.6kOhm => ~1.27mA at 3.3V. No external supply.
IO_LOC "joystick_vcc" B16;
IO_PORT "joystick_vcc" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=8;
