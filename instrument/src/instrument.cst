// Tang Mega 60K NEO J13: schematic p19 physical pin -> SDRAM0_Dn;
// Sipeed TangMega-60K-example/sdram_neo/src/sdram.cst -> 60K FPGA ball.
// These are NOT the shared 138K board silkscreen ball names.
IO_LOC "mpr_scl" E14;
IO_LOC "mpr_sda" E13;
IO_LOC "dac_bck" C15;
IO_LOC "dac_lrck" C14;
IO_LOC "dac_din" B13;
IO_PORT "mpr_scl" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "mpr_sda" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_lrck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_LOC "led[0]" P19;
IO_LOC "led[1]" R19;
IO_LOC "led[2]" T21;
IO_LOC "led[3]" U21;
IO_LOC "led[4]" P16;
IO_LOC "led[5]" R17;
IO_LOC "led[6]" R18;
IO_LOC "led[7]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Sipeed 60K on-board crystal; no external connection required.
IO_LOC "ref_clk" V22;
IO_PORT "ref_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
CLOCK_LOC "clk" BUFG = CLK;

// Sipeed TangMega-60K-example/cam_dvi/src/NEO_DOCK.cst, differential pairs.
IO_LOC "tmds_p[0]" J14,H14;
IO_LOC "tmds_p[1]" J15,H15;
IO_LOC "tmds_p[2]" K17,J17;
IO_LOC "tmds_clock_p" G15,G16;
IO_PORT "tmds_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_clock_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hpd_en" K13;
IO_PORT "hpd_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=12 BANK_VCCIO=3.3;
CLOCK_LOC "pixel_clk" BUFG = CLK;
CLOCK_LOC "serial_clk" BUFG = CLK;
INS_LOC "display_clock/pll" PLL_R[0];
